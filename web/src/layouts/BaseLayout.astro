---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Patrones de diseño para sistemas inteligentes y arquitecturas agénticas.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Patrones IA - Inicio">
        <span class="brand-mark">P/IA</span>
        <span>Patrones IA</span>
      </a>
      <nav aria-label="Navegación principal">
        <a href={`${base}patterns/`}>Patrones</a>
        <a href={`${base}evidence/`}>Evidencia</a>
        <a href={`${base}book/`}>Libro</a>
        <a href="https://github.com/rubences/patrones_dise-o_ia">GitHub</a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <p><strong>Patrones IA</strong> · Catálogo abierto y ejecutable de patrones para ingeniería de IA.</p>
      <p>Contenido y código del proyecto bajo las licencias declaradas en el repositorio.</p>
    </footer>
  </body>
</html>
