---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import taxonomy from '../../../catalog/taxonomy.json';
import research from '../../../publications/research-monograph-en/publication.json';
import teaching from '../../../publications/teaching-manual-es/publication.json';

const patterns = (await getCollection('patterns')).sort((a, b) => a.data.patternId - b.data.patternId);
const base = import.meta.env.BASE_URL;
const familyCards = taxonomy.families.map((family) => ({...family,count:patterns.filter((pattern)=>pattern.data.family===family.id).length})).filter((family)=>family.count>0);
---

<BaseLayout title="Patrones IA — Patrones de diseño para sistemas inteligentes">
  <section class="hero">
    <div>
      <p class="eyebrow">Open catalog · TypeScript · AI engineering</p>
      <h1>Patrones de diseño para sistemas de IA.</h1>
      <p class="lead">Una biblioteca de patrones y contratos de referencia para agentes, AI Factories, RAG/grafos, decisiones agénticas, evaluación, seguridad, fiabilidad y autonomía acotada. La evidencia se declara por patrón.</p>
      <div class="actions">
        <a class="button primary" href={`${base}patterns/`}>Explorar {patterns.length} patrones</a>
        <a class="button" href={`${base}lab/`}>Laboratorio Archify</a>
        <a class="button" href={`${base}publications/`}>Dos publicaciones</a>
        <a class="button" href={`${base}evidence/`}>Estado de evidencia</a>
      </div>
    </div>

    <div class="stat-grid" aria-label="Resumen del catálogo">
      <div class="stat"><strong>{patterns.length}</strong><span>implementaciones TypeScript</span></div>
      <div class="stat"><strong>{taxonomy.families.length}</strong><span>macrofamilias editoriales</span></div>
      <div class="stat"><strong>{patterns.length}</strong><span>fichas canónicas publicadas</span></div>
      <div class="stat"><strong>2</strong><span>obras editoriales independientes</span></div>
    </div>
  </section>

  <section class="section" id="macrofamilias">
    <div class="section-heading">
      <div><p class="eyebrow">Exploración por dominio</p><h2>Elige una macrofamilia.</h2></div>
      <p>Los {patterns.length} patrones se organizan en {familyCards.length} macrofamilias. Accede directamente a cada área, con sus patrones, fichas y diagramas interactivos.</p>
    </div>
    <div class="family-grid">
      {familyCards.map((family, index) => (
        <a class="family-card" href={`${base}patterns/?family=${encodeURIComponent(family.id)}#catalog-results`}>
          <div class="family-card-top"><span class="family-index">{String(index+1).padStart(2,'0')}</span><strong>{family.count} patrones</strong></div>
          <h3>{family.nameEs}</h3>
          <p>{family.description}</p>
          <span class="family-card-link">Explorar familia →</span>
        </a>
      ))}
    </div>
    <div class="actions"><a class="button primary" href={`${base}patterns/`}>Ver el catálogo completo</a></div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Arquitectura editorial</p><h2>Una base técnica. Dos libros. Una web.</h2></div>
      <p>El catálogo, el código, la taxonomía y el Evidence Pack son el sustrato compartido. Cada publicación construye una obra nueva para una audiencia y una finalidad diferentes.</p>
    </div>
    <div class="card-grid">
      <a class="pattern-card" href={`${base}publications/research-monograph/`}><span class="pattern-number">RESEARCH · EN</span><h3>{research.title}</h3><p>Monografía de investigación sobre sistemas agénticos, MCP, seguridad, resiliencia y Edge–Mesh–Cloud.</p></a>
      <a class="pattern-card" href={`${base}publications/teaching-manual/`}><span class="pattern-number">TEACH · ES</span><h3>{teaching.title}</h3><p>Manual universitario con Python, Docker, n8n, laboratorios, ejercicios, rúbricas y capstone.</p></a>
      <a class="pattern-card" href={`${base}patterns/`}><span class="pattern-number">EXPLORE</span><h3>Web</h3><p>Referencia navegable de las {patterns.length} fichas, filtros y relaciones.</p></a>
      <a class="pattern-card" href="https://github.com/rubences/patrones_dise-o_ia"><span class="pattern-number">BUILD</span><h3>Código</h3><p>{patterns.length} implementaciones TypeScript enlazadas con su ficha.</p></a>
      <a class="pattern-card" href={`${base}evidence/`}><span class="pattern-number">VERIFY</span><h3>Evidencia</h3><p>Cobertura, fuentes primarias, estado de evidencia y hashes reproducibles.</p></a>
      <a class="pattern-card" href={`${base}book/`}><span class="pattern-number">REFERENCE</span><h3>Edición reproducible</h3><p>Build técnico del catálogo completo en Markdown, HTML, EPUB y PDF; no es el manuscrito comercial de ninguna de las dos obras.</p></a>
    </div>
  </section>
</BaseLayout>

<style>
.family-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:1rem}
.family-card{display:flex;flex-direction:column;min-height:205px;padding:1.3rem;border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,rgba(23,35,58,.85),rgba(16,23,38,.85));text-decoration:none;transition:transform .18s,border-color .18s}
.family-card:hover,.family-card:focus-visible{transform:translateY(-3px);border-color:var(--accent-2);outline-offset:3px}
.family-card-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:.8rem}
.family-index{color:var(--accent-2);font-weight:800;letter-spacing:.12em}
.family-card h3{font-size:1.25rem;margin:1.1rem 0 .5rem}
.family-card p{color:var(--muted);font-size:.91rem;line-height:1.55;margin:0 0 1rem}
.family-card-link{margin-top:auto;color:var(--accent-2);font-weight:700;font-size:.88rem}
@media(prefers-reduced-motion:reduce){.family-card{transition:none}.family-card:hover{transform:none}}
</style>
