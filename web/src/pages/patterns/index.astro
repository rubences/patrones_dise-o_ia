---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const patterns = (await getCollection('patterns')).sort((a, b) => a.data.patternId - b.data.patternId);
const base = import.meta.env.BASE_URL;
const families = [...new Set(patterns.map((p) => p.data.family))].sort();
---

<BaseLayout title="Catálogo — Patrones IA" description="Explora el catálogo canónico de patrones de diseño para sistemas de IA.">
  <section class="catalog-hero">
    <p class="eyebrow">Pattern catalog</p>
    <h1>Explorar patrones.</h1>
    <p class="lead">Busca por nombre, etiqueta o familia. El catálogo crecerá hasta cubrir las 102 implementaciones del repositorio.</p>

    <div class="catalog-toolbar" aria-label="Filtros del catálogo">
      <input id="pattern-search" type="search" placeholder="Buscar RAG, seguridad, agente..." aria-label="Buscar patrones" />
      <select id="family-filter" aria-label="Filtrar por familia">
        <option value="">Todas las familias</option>
        {families.map((family) => <option value={family}>{family}</option>)}
      </select>
      <select id="difficulty-filter" aria-label="Filtrar por dificultad">
        <option value="">Todas las dificultades</option>
        <option value="beginner">Beginner</option>
        <option value="intermediate">Intermediate</option>
        <option value="advanced">Advanced</option>
      </select>
    </div>

    <p id="result-count" class="lead" style="font-size: .95rem;">{patterns.length} patrón(es) visible(s)</p>
  </section>

  <section class="section" style="padding-top: 1rem;">
    <div id="pattern-grid" class="card-grid">
      {patterns.map((pattern) => (
        <a
          class="pattern-card"
          href={`${base}patterns/${pattern.data.slug}/`}
          data-pattern-card
          data-family={pattern.data.family}
          data-difficulty={pattern.data.difficulty}
          data-search={`${pattern.data.title} ${pattern.data.summary} ${pattern.data.tags.join(' ')}`.toLowerCase()}
        >
          <span class="pattern-number">PATTERN {String(pattern.data.patternId).padStart(3, '0')}</span>
          <h3>{pattern.data.title}</h3>
          <p>{pattern.data.summary}</p>
          <div class="tags">
            <span class="tag">{pattern.data.family}</span>
            <span class="tag">{pattern.data.difficulty}</span>
            <span class="tag">{pattern.data.maturity}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    const search = document.querySelector('#pattern-search');
    const family = document.querySelector('#family-filter');
    const difficulty = document.querySelector('#difficulty-filter');
    const count = document.querySelector('#result-count');
    const cards = Array.from(document.querySelectorAll('[data-pattern-card]'));

    const applyFilters = () => {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
      const selectedFamily = family instanceof HTMLSelectElement ? family.value : '';
      const selectedDifficulty = difficulty instanceof HTMLSelectElement ? difficulty.value : '';
      let visible = 0;

      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
        const matchesFamily = !selectedFamily || card.dataset.family === selectedFamily;
        const matchesDifficulty = !selectedDifficulty || card.dataset.difficulty === selectedDifficulty;
        const show = matchesQuery && matchesFamily && matchesDifficulty;
        card.hidden = !show;
        if (show) visible += 1;
      }

      if (count) count.textContent = `${visible} patrón(es) visible(s)`;
    };

    search?.addEventListener('input', applyFilters);
    family?.addEventListener('change', applyFilters);
    difficulty?.addEventListener('change', applyFilters);
  </script>
</BaseLayout>
