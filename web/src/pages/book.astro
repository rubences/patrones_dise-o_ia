---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const patterns = await getCollection('patterns');
const families = new Set(patterns.map((p) => p.data.family)).size;
---

<BaseLayout title="Libro — Patrones IA" description="Libro generado desde el catálogo canónico de 102 patrones de diseño para sistemas de IA.">
  <section class="catalog-hero">
    <p class="eyebrow">LEARN · Primera edición abierta</p>
    <h1>Un libro generado desde el catálogo vivo.</h1>
    <p class="lead">102 patrones para construir agentes, sistemas RAG y arquitecturas de IA seguras, fiables y escalables. El manuscrito se ensambla desde exactamente las mismas fichas que ves en la web.</p>
    <div class="actions">
      <a class="button primary" href={`${import.meta.env.BASE_URL}patterns/`}>Explorar los patrones</a>
      <a class="button" href="https://github.com/rubences/patrones_dise-o_ia/actions/workflows/book-artifacts.yml">Builds HTML · EPUB · PDF</a>
    </div>
  </section>

  <section class="section">
    <div class="stat-grid">
      <div class="stat"><strong>{patterns.length}</strong><span>capítulos de patrón</span></div>
      <div class="stat"><strong>{families}</strong><span>partes editoriales</span></div>
      <div class="stat"><strong>3</strong><span>formatos distribuibles</span></div>
      <div class="stat"><strong>SHA-256</strong><span>trazabilidad por build</span></div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Pipeline</p><h2>Fuente → manuscrito → edición.</h2></div>
      <p>Los binarios no se commitean. GitHub Actions genera HTML, EPUB y PDF, verifica sus firmas y publica un bundle temporal con manifests criptográficos.</p>
    </div>
    <div class="card-grid">
      <article class="pattern-card"><span class="pattern-number">01 · SOURCE</span><h3>102 fichas</h3><p>Contenido canónico y enlaces a implementaciones TypeScript.</p></article>
      <article class="pattern-card"><span class="pattern-number">02 · ASSEMBLE</span><h3>10 partes</h3><p>El orden sale de taxonomy.json y el build exige 102 capítulos.</p></article>
      <article class="pattern-card"><span class="pattern-number">03 · RENDER</span><h3>HTML · EPUB · PDF</h3><p>Quarto transforma el manuscrito derivado sin alterar la fuente editorial.</p></article>
      <article class="pattern-card"><span class="pattern-number">04 · VERIFY</span><h3>Release manifest</h3><p>Firmas de formato, tamaño y SHA-256 enlazados con corpus y manuscrito.</p></article>
    </div>
  </section>
</BaseLayout>
