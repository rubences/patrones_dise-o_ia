{
  "name": "cinco-patrones-agenticos-openai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cinco ejemplos pedagógicos de patrones agénticos con TypeScript y OpenAI Responses API.",
  "scripts": {
    "pattern:1": "npm run build --silent && node dist/src/pattern_1_pipeline.js",
    "pattern:2": "npm run build --silent && node dist/src/pattern_2_router.js",
    "pattern:3": "npm run build --silent && node dist/src/pattern_3_reflection.js",
    "pattern:4": "npm run build --silent && node dist/src/pattern_4_orchestrator_workers.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build --silent && node --test dist/test/patterns.test.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "openai": "^6.48.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3"
  }
}
