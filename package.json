    "ai",
    "design-patterns",
    "gang-of-four",
    "typescript",
    "llm",
    "agentic-workflows",
    "factory",
    "adapter",
    "decorator",
    "strategy",
    "chain-of-responsibility"
  ],
  "author": "rubences",
  "license": "MIT",
  "dependencies": {
    "openai": "^6.48.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3"
  }
}
