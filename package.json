{
  "name": "patrones-agentes-ia",
  "version": "3.0.0",
  "description": "14 patrones de diseño: 8 patrones agénticos + 6 patrones de diseño clásicos (Gang of Four) adaptados para sistemas de IA",
  "type": "module",
  "main": "src/common.ts",
  "scripts": {
    "pattern:1": "node --loader ts-node/esm src/pattern_1_pipeline.ts",
    "pattern:2": "node --loader ts-node/esm src/pattern_2_router.ts",
    "pattern:3": "node --loader ts-node/esm src/pattern_3_reflection.ts",
    "pattern:4": "node --loader ts-node/esm src/pattern_4_evaluator_optimizer.ts",
    "pattern:5": "node --loader ts-node/esm src/pattern_5_tool_use.ts",
    "pattern:6": "node --loader ts-node/esm src/pattern_6_planning.ts",
    "pattern:7": "node --loader ts-node/esm src/pattern_7_multi_agent.ts",
    "pattern:8": "node --loader ts-node/esm src/pattern_8_human_in_loop.ts",
    "pattern:9": "node --loader ts-node/esm src/pattern_9_factory.ts",
    "pattern:10": "node --loader ts-node/esm src/pattern_10_builder.ts",
    "pattern:11": "node --loader ts-node/esm src/pattern_11_adapter.ts",
    "pattern:12": "node --loader ts-node/esm src/pattern_12_decorator.ts",
    "pattern:13": "node --loader ts-node/esm src/pattern_13_strategy.ts",
    "pattern:14": "node --loader ts-node/esm src/pattern_14_chain.ts"
  },
  "keywords": [
    "openai",
